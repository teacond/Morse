#: data/ui/window.blp:118 data/ui/window.blp:120
msgid "Speed"
msgstr "Швидкість"

#: data/ui/window.blp:121
msgid "The speed of the text in CPM"
msgstr "Швидкість набору тексту у знаках за хвилину (CPM)"

#: data/ui/window.blp:125
msgid "Delay between characters"
msgstr "Затримка між символами"

#: data/ui/window.blp:126
msgid ""
"The delay between words is calculated automatically. The default value is 3."
msgstr "Пауза між словами обчислюється автоматично. Стандартне значення то 3."

