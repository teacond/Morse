msgstr "Генерація тексту"

#: data/ui/window.blp:98
msgid "Default word count"
msgstr "Кількість слів за замовчуванням"

#: data/ui/window.blp:99
msgid "The word count is calculated automatically based on the text speed"
msgstr "Кількість слів підраховується автоматично, виходячи зі швидкості"

#: data/ui/window.blp:103
msgid "Words"
msgstr "Слова"

#: data/ui/window.blp:108
